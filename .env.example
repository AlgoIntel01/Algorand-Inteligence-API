# Network: "mainnet" or "testnet"
NETWORK=mainnet

# Algorand address that receives USDCa payments (must be opted in to the USDC ASA).
# Generate one with: npm run create-wallet
SELLER_ADDRESS=

# Seller account mnemonic — only needed by scripts/optin-usdca.ts, never by the server.
SELLER_MNEMONIC=

# x402 facilitator (GoPlausible)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Where this API is reachable (used in route resource metadata for discovery)
PUBLIC_BASE_URL=http://localhost:3402

PORT=3402

# Optional: free Etherscan V2 key (etherscan.io/apis) enables BSC wallet analysis.
# Without it, wallet analysis covers algorand/ethereum/base (token analysis unaffected).
ETHERSCAN_API_KEY=

# Anthropic API key for LLM-written verdicts (get one at console.anthropic.com).
# Leave empty to use deterministic templated verdicts (verdict_source: "template").
ANTHROPIC_API_KEY=
# Model for verdict synthesis. Haiku keeps per-call cost at a fraction of a cent.
VERDICT_MODEL=claude-haiku-4-5

# Buyer-side settings, only for the paying scripts. One key per network so a
# mainnet run can never fall back to a testnet wallet, or vice versa.
# test-client picks MAINNET_BUYER_KEY or TESTNET_BUYER_KEY based on NETWORK,
# falling back to BUYER_PRIVATE_KEY_B64 if the network-specific one is unset.
MAINNET_BUYER_KEY=
TESTNET_BUYER_KEY=
BUYER_PRIVATE_KEY_B64=
API_URL=http://localhost:3402
